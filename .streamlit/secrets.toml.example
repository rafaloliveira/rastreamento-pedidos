# Copie este arquivo para .streamlit/secrets.toml e preencha com os valores
# reais. O arquivo secrets.toml NUNCA deve ser commitado (já está no
# .gitignore).

# Credenciais da service account do Google Cloud usada para escrever
# na planilha de log (Google Sheets). Gere em:
# https://console.cloud.google.com/iam-admin/serviceaccounts
# > Chaves > Adicionar chave > JSON, e cole os campos abaixo (mesmo formato
# do arquivo JSON baixado). Compartilhe a planilha (config.LOG_SHEET_ID)
# com o e-mail "client_email" abaixo, com permissão de Editor.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
